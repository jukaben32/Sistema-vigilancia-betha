{
  "name": "betha-sentinel",
  "version": "3.0.0",
  "description": "Sistema de vigilancia 24/7 con IA en servidor (YOLOX/ONNX), multi-cámara, clips con pre-evento, SQLite y bot de Telegram",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "node test/e2e.js",
    "model:download": "node scripts/download-model.js",
    "postinstall": "node scripts/download-model.js yolox_nano --soft"
  },
  "keywords": [
    "vigilancia",
    "cctv",
    "ai",
    "yolox",
    "onnx",
    "security",
    "sqlite",
    "telegram",
    "websockets"
  ],
  "author": "Betha Security Team",
  "license": "MIT",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.3.0",
    "fs-extra": "^11.2.0",
    "helmet": "^8.3.0",
    "onnxruntime-node": "^1.31.1",
    "sharp": "^0.35.5",
    "sqlite3": "^6.0.1",
    "twilio": "^5.7.1",
    "ws": "^8.22.0"
  }
}
