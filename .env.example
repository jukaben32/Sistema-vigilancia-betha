# ==============================================================================
# BETHA SENTINEL v3 // VARIABLES DE ENTORNO
# Copia este archivo como .env y ajusta lo que necesites. Todo es opcional.
# ==============================================================================

PORT=3000

# Dónde escucha el servidor:
#   127.0.0.1 → solo este PC (por defecto, lo más seguro)
#   0.0.0.0   → también la red local y Tailscale (para verlo desde el móvil)
HOST=127.0.0.1

# Contraseña inicial del panel (si no la pones, se crea desde http://localhost:3000)
ADMIN_PASSWORD=

# Pon true solo si usas un túnel/proxy HTTPS delante (Cloudflare Tunnel, Caddy...)
TRUST_PROXY=false

# URL pública para los enlaces en Telegram (ej. https://mi-pc.tu-tailnet.ts.net:3000)
PUBLIC_URL=

# Ruta de FFmpeg si quieres usar uno propio (por defecto: el del sistema o el incluido)
FFMPEG_PATH=

# TELEGRAM (también se puede configurar desde Ajustes en el panel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WHATSAPP / TWILIO (opcional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_PHONE=
